# Cloudflare credentials used by Wrangler.
# Keep the real .env uncommitted.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Hostnames. Create these once in Cloudflare DNS, then deploy the apps page and
# relay Workers to the matching route patterns.
LLMING_APPS_HOST='apps.example.com'
LLMING_RELAY_HOST='relay.example.com'
LLMING_TEST_APPS_HOST='test-apps.example.com'
LLMING_TEST_RELAY_HOST='test-relay.example.com'

# Worker routes derived from the hostnames above.
LLMING_RELAY_ROUTE='relay.example.com/*'

# Disabled-by-default public integration-test relay.
LLMING_TEST_RELAY_ROUTE='test-relay.example.com/*'
LLMING_TEST_RELAY_ADMISSION_HASH='sha256:<hex-sha256>'
LLMING_TEST_RELAY_WINDOW_SECONDS=900

# DNS setup helper defaults. The included setup script creates proxied records.
LLMING_CLOUDFLARE_DNS_RECORD_TYPE='AAAA'
LLMING_CLOUDFLARE_DNS_RECORD_CONTENT='100::'
