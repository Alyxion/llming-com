# =============================================================================
# llming-com · Courier subpackage — deployment configuration
# =============================================================================
# Copy to `.env` (git-ignored) and fill with your own values, OR feed these as
# Azure Function App Settings (see deploy/courier/azure/local.settings.json.example).
# NEVER commit real account names, URLs, keys, or organisation identifiers.
#
# Every value below is read by llming_com.courier.config.Settings (COURIER_*
# prefix) plus the storage-plane variables consumed by
# llming_com.courier.azure_host.build_service(). This file is the single source
# of truth for what the Courier needs to run and deploy.

# --- Upload authentication (comma-separated bearer keys) ---------------------
# Empty disables auth (DEV ONLY). Required for any real deployment.
COURIER_API_KEYS=dev-key

# --- Capability-URL assembly -------------------------------------------------
# Base URL embedded in returned download links — HOST ROOT ONLY.
# All routes are served under the /courier prefix and download URLs add
# /courier/o, so do NOT append /api or /courier here.
# Dev:   http://localhost:8000   -> e.g. http://localhost:8000/courier/o/<id>
# Azure: https://<your-function-app>.azurewebsites.net
COURIER_PUBLIC_BASE_URL=http://localhost:8000
COURIER_CONTAINER=exchange

# --- Dev-server capability-token signing -------------------------------------
# HMAC secret for the local SAS-equivalent tokens. Override everywhere real
# (a random 32+ byte secret).
COURIER_SIGNING_KEY=dev-insecure-signing-key-change-me

# --- Policy / limits ---------------------------------------------------------
COURIER_DEFAULT_TTL_SECONDS=7200        # 2h default object TTL
COURIER_MAX_TTL_SECONDS=2592000         # 30d hard maximum
COURIER_MAX_UPLOAD_BYTES=104857600      # 100 MB
COURIER_DEFAULT_SINGLE_USE=false
# When false, force Function-mediated downloads (managed-identity deploys with
# no SAS signing). Default true uses direct-to-blob SAS where supported.
COURIER_PREFER_DIRECT_SAS=true

# --- Azure storage backend (PRODUCTION) --------------------------------------
# Leave unset for the in-memory dev path. Required for the Azure Function host.
# COURIER_ACCOUNT_URL=https://<your-account>.blob.core.windows.net
# Optional shared key; omit to use managed identity (DefaultAzureCredential).
# COURIER_ACCOUNT_KEY=<shared-key-or-leave-unset-to-use-managed-identity>

# --- Azure Functions runtime (set as App Settings, not needed for dev) -------
# AzureWebJobsStorage=<functions-runtime-storage-connection-string>
# FUNCTIONS_WORKER_RUNTIME=python
